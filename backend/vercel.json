{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{eval/**,scripts/**,alembic/**,.venv/**,**/__pycache__/**}"
    }
  },
  "schedules": {
    "cleanup": {
      "schedule": "0 3 * * *",
      "path": "/api/cron/cleanup",
      "requestMethod": "GET"
    }
  }
}